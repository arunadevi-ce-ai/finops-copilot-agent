# Copy this file to .env and fill in real values. .env is gitignored —
# never commit actual keys.

# Required by orchestrator.py and mcp_server.py (LLM calls for the
# investigation/retrieval/recommendation agents). Not needed for
# detector.py or rag.py alone.
OPENAI_API_KEY=""

# Not currently used by any code path in this repo — present for future
# GCP-specific work.
GCP_PROJECT_ID=""

# Optional. Unset by default -> orchestrator.py uses an in-memory
# checkpointer and api.py refuses to start (it has no fallback: token
# storage needs a real Redis). Set this to run api.py locally or to
# exercise the Redis-backed checkpointer path, e.g. against a throwaway
# `docker run -p 6379:6379 redis:7-alpine`.
# REDIS_URL="redis://localhost:6379/0"

# Optional. Unset by default -> detector.py reads billing_export.csv,
# utilization_metrics.csv, and resource_metadata.json, and
# generate_mock_data.py only writes those files. Set to a
# fully-qualified BigQuery dataset id (project.dataset) to read/write
# all three from BigQuery instead — mirrors how GCP's real Billing
# Export writes to BigQuery (billing at least; utilization/metadata
# don't really live in BigQuery in a real deployment, but putting all
# three there makes a convenient single look-alike dataset for
# testing). Expects three tables inside it: billing_export,
# utilization_metrics, resource_metadata — see README.md's "BigQuery
# backend" section for their schemas and the commands to create them.
# BIGQUERY_DATASET="my-project.finops_copilot"
